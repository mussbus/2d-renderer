# Current source and structured inputs have canonical LF bytes on every checkout.
*.zig text eol=lf
*.zon text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.hlsl text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.tsv text eol=lf
# OBJ here is exported textual geometry, never a compiled object file.
*.obj text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# P6 PPM images can lack NUL bytes; automatic text detection corrupts them.
*.png binary
*.ppm binary
*.zip binary

# CRLF is intentional in frozen captures; retain all other default whitespace checks.
# Frozen captures retain exact raw bytes. README and later unpinned reports
# remain normal Markdown; only the twenty existing exact-hash artifacts opt out.
/docs/history/prompts/exact/*-source.txt -text !eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
